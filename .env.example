# Default demo: local Ollama. Provider choices: ollama, anthropic.
LLM_PROVIDER=ollama
# Preferred native preview port; startup skips ports occupied by other projects.
APP_PORT=8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional cloud provider. No automatic fallback from local to cloud.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DATABASE_URL=postgresql+psycopg://lenny:lenny_local_only@127.0.0.1:54329/lenny
AGENT_URL=http://127.0.0.1:8788
AGENT_TOKEN=local-development-only
MODEL_TIMEOUT_SECONDS=1500
TRANSCRIPT_DIR=data/transcripts/episodes
RETRIEVAL_LIMIT=5
# Only enable for unit tests; the application requires PostgreSQL.
ALLOW_SQLITE=false

# Hosted demo access. Required in production; leave password empty for local use.
ENVIRONMENT=development
ACCESS_USERNAME=reviewer
ACCESS_PASSWORD=
GENERATION_REQUESTS_PER_HOUR=30
